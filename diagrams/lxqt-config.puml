@startuml
!include theme.iuml
left to right direction
rectangle "LXQt desktop\n(README.md lists two looks)" as D
rectangle "Same in both looks" as S {
  [Icons\nWVista icon theme] as IC
  [Widgets\nKvantum RoughGlass] as KV
  [App menu icon\nTux orb] as ORB
}
rectangle "Different per look\naero_wannabe / what_even_is_ts" as P {
  [LXQt theme\nViewGlass / System] as LT
  [XFWM4 theme\nAeroBird / SilverTox] as XF
  [QTerminal theme\nCampbell Powershell / WhiteOnBlack] as QT
  file "Task bar image\nvista-69.png / skeuomorphic_white.png" as TB
}
D --> IC
D --> KV
D --> ORB
D --> LT
D --> XF
D --> QT
D --> TB
LT ..> KV : in look 2, picks Kvantum
@enduml
